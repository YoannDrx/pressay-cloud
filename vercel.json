{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bunx bun@1.2.19 install --frozen-lockfile",
  "buildCommand": "bun run build:deploy",
  "framework": "hono",
  "regions": ["fra1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/v1/internal/jobs/account-deletions",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
