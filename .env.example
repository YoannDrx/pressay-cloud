NODE_ENV=development
PRESSAY_DEPLOYMENT_ENV=development
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PRESSAY_ALLOWED_ORIGINS=http://localhost:1420,https://press-say.app
PRESSAY_API_URL=http://localhost:3000
# Single end-user identity issuer: the web app's Better Auth OAuth 2.1 server.
PRESSAY_BETTER_AUTH_JWT_ISSUER=https://press-say.app
PRESSAY_BETTER_AUTH_JWKS_URL=https://press-say.app/api/auth/jwks
PRESSAY_BETTER_AUTH_JWT_AUDIENCE=https://api.press-say.app
PRESSAY_WEB_PROXY_JWT_AUDIENCE=pressay-web-proxy
PRESSAY_WEB_PROXY_LEGACY_AUDIENCE_ALLOWED=true
PRESSAY_DESKTOP_OAUTH_CLIENT_ID=w9ckUgrcFp7H7wNV
PRESSAY_INTERNAL_JWT_ISSUER=https://press-say.app/internal
PRESSAY_INTERNAL_JWT_SECRET=replace-with-the-secret-shared-with-the-web-server
# Cloud -> web internal calls (identity deletion). The origin defaults to the
# issuer origin above when unset.
PRESSAY_CLOUD_INTERNAL_JWT_ISSUER=https://api.press-say.app/internal
PRESSAY_WEB_INTERNAL_ORIGIN=https://press-say.app
DEVICE_IDENTIFIER_HMAC_SECRET=replace-with-an-independent-32-byte-secret
RATE_LIMIT_HMAC_SECRET=replace-with-an-independent-32-byte-secret
CRON_SECRET=replace-with-an-independent-32-byte-secret
# Optional HTTPS webhook (Slack-compatible or any JSON receiver) for the daily
# operations digest. Unset: the digest is only written to the logs.
# OPS_ALERT_WEBHOOK_URL=https://hooks.example.com/pressay-ops
PRESSAY_CLOUD_PROCESSING_ENABLED=false
PRESSAY_REFERRALS_ENABLED=false
PRESSAY_CAMPAIGN_SECRET=replace-with-an-independent-32-byte-secret
# Verified email(s) allowed to claim the single operations owner seat.
PRESSAY_OPERATIONS_OWNER_EMAILS=owner@example.com
PRESSAY_CLOUD_ACCOUNT_RATE_PER_MINUTE=60
PRESSAY_CLOUD_DEVICE_RATE_PER_MINUTE=30
PRESSAY_CLOUD_IP_RATE_PER_MINUTE=120
# Retention of operational records, in days (purged by the daily deletion cron).
PRESSAY_RETENTION_IDEMPOTENCY_DAYS=30
PRESSAY_RETENTION_USAGE_RESERVATION_DAYS=395
PRESSAY_RETENTION_PROVIDER_EVENT_DAYS=400
# operations_audit: reads and exports (reason personal_data_read or data_export)
# for READ days, every other entry for ACTION days.
PRESSAY_RETENTION_AUDIT_READ_DAYS=365
PRESSAY_RETENTION_AUDIT_ACTION_DAYS=1825
ENTITLEMENT_SIGNING_PRIVATE_KEY=
ENTITLEMENT_SIGNING_KEY_ID=pressay-entitlement-2026-01
APPLE_APP_BUNDLE_IDENTIFIER=fr.yodev.pressay
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY_BASE64=
APP_STORE_APP_APPLE_ID=
APP_STORE_PRODUCT_PRO_MONTHLY=
APP_STORE_PRODUCT_PRO_ANNUAL=
# Production keeps verifying Apple Sandbox purchases for App Review, but a
# Sandbox purchase grants Pro only to the Pressay account UUIDs listed below
# (comma-separated). An empty list grants nothing. Before submitting a build,
# add the UUID of the App Review demo account (see docs/DEPLOYMENT.md).
# Sandbox access is capped and never unlocks Cloud processing or sync.
APPLE_SANDBOX_IN_PRODUCTION_ENABLED=true
APPLE_SANDBOX_ALLOWED_ACCOUNT_IDS=
APPLE_SANDBOX_MAX_GRANT_HOURS=24
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSFORM_MODEL=gpt-5-mini-2025-08-07
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
OPENAI_TRANSFORM_TIMEOUT_MS=45000
OPENAI_TRANSCRIPTION_TIMEOUT_MS=120000
# Local development accepts test credentials only. Canonical staging requires
# rk_test_; production requires rk_live_. Standard sk_ keys are rejected there.
STRIPE_SECRET_KEY=
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_COMMERCIAL_LAUNCH_ENABLED=false
# Enable only after Stripe Tax is activated with registrations in the Dashboard.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TAX_ID_COLLECTION_ENABLED=false
STRIPE_PRODUCT_TAX_CODE=txcd_10103000
STRIPE_PAST_DUE_GRACE_DAYS=7
PRESSAY_PRO_CURRENCY=eur
PRESSAY_PRO_MONTHLY_AMOUNT_MINOR=799
PRESSAY_PRO_ANNUAL_AMOUNT_MINOR=6900
# Optional App Store catalogue prices for metrics when a signed transaction
# carries no price (default: the two amounts above).
# PRESSAY_APP_STORE_MONTHLY_AMOUNT_MINOR=799
# PRESSAY_APP_STORE_ANNUAL_AMOUNT_MINOR=6900
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_PRO=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_CHECKOUT_SUCCESS_URL=https://press-say.app/account?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://press-say.app/checkout/cancel
STRIPE_PORTAL_RETURN_URL=https://press-say.app/account
LOG_LEVEL=info
