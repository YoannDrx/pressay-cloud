{
  "name": "@pressay/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.2.19",
  "scripts": {
    "dev": "vercel dev",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "build:deploy": "bun run build && bun run deployment:assert",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "secretlint '**/*' --secretlintignore .gitignore",
    "audit:dependencies": "tsx scripts/audit-runtime.ts",
    "ci:source": "bun run verify && bun run secrets:check && bun run audit:dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-schema.ts",
    "deployment:assert": "tsx scripts/assert-deployment.ts",
    "release:prepare": "bun run ci:source && bun run db:migrate && bun run db:check && bun run billing:configure",
    "billing:configure": "tsx scripts/configure-billing.ts",
    "billing:audit": "tsx scripts/audit-stripe-catalogue.ts",
    "billing:provision": "tsx scripts/provision-stripe-catalogue.ts",
    "billing:configure:app-store": "tsx scripts/configure-app-store-billing.ts",
    "jobs:account-deletions": "tsx scripts/run-account-deletions.ts",
    "validate:staging": "tsx scripts/validate-staging.ts",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@neondatabase/serverless": "1.1.0",
    "better-call": "1.4.0",
    "better-auth": "1.7.3",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "openai": "7.10.0",
    "pg": "8.23.0",
    "resend": "6.26.0",
    "stripe": "22.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "22.19.11",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2"
  }
}
